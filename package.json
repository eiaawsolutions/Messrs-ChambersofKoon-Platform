{
  "name": "matter-velocity-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Matter Velocity Platform — Messrs Chambers of Koon. Single-tenant legal operations platform by EIAAW Solutions Sdn Bhd.",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run widget:build && next build",
    "start": "next start",
    "worker": "tsx --conditions=react-server src/jobs/worker.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "evals": "vitest run --config vitest.evals.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=react-server src/lib/db/migrate.ts",
    "db:seed": "tsx --conditions=react-server src/lib/db/seed.ts",
    "seed:templates": "tsx --conditions=react-server scripts/seed-templates.ts",
    "grant:admin": "tsx --conditions=react-server scripts/grant-admin.ts",
    "db:studio": "drizzle-kit studio",
    "widget:build": "tsx scripts/build-widget.ts",
    "release": "node scripts/start.mjs",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "prepare": "lefthook install || true"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@auth/drizzle-adapter": "^1.11.3",
    "@aws-sdk/client-s3": "^3.1107.0",
    "@aws-sdk/s3-request-presigner": "^3.1107.0",
    "@sentry/nextjs": "^10.70.0",
    "docxtemplater": "^3.69.3",
    "drizzle-orm": "^0.45.2",
    "mammoth": "^1.12.1",
    "next": "^16.3.0",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.23.0",
    "pg-boss": "^12.27.0",
    "pizzip": "^3.2.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "unpdf": "^1.8.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "^4.1.10",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "lefthook": "^2.1.10",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "~5.9.3",
    "vitest": "^4.1.10"
  }
}
