# =============================================================================
# Matter Velocity Platform — environment
# EIAAW Solutions Sdn Bhd (202603133419)
#
# HOUSE RULE (EIAAW Deploy Contract):
# The ONLY raw secrets permitted in this file, in Railway env, or in any
# deployment-target config are the three Infisical bootstrap credentials below.
# Every other secret is referenced by a `secret://<project>/<env>/<NAME>` handle
# and resolved at boot by src/lib/secrets/resolver.ts.
#
# Never paste an sk-ant-…, re_…, or any live key into this file or Railway.
# =============================================================================

# --- Infisical bootstrap (the only raw secrets) ------------------------------
INFISICAL_RESOLVER_ENABLED=false           # production sets true
INFISICAL_SITE_URL=https://app.infisical.com
INFISICAL_APP_CLIENT_ID=
INFISICAL_APP_CLIENT_SECRET=
INFISICAL_PROJECT_ID=
INFISICAL_ENVIRONMENT=dev
INFISICAL_CACHE_TTL=300
INFISICAL_REQUEST_TIMEOUT=5000

# --- Application -------------------------------------------------------------
NODE_ENV=development
APP_ENV=development                        # development | uat | production
APP_BASE_URL=http://localhost:3000
FIRM_NAME=Messrs Chambers of Koon
FIRM_SHORT_NAME=Chambers of Koon
FIRM_TIMEZONE=Asia/Kuala_Lumpur

# --- Database ----------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/matter_velocity
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/matter_velocity

# --- Anthropic (Claude) ------------------------------------------------------
ANTHROPIC_API_KEY=secret://chambersofkoon-prod/prod/ANTHROPIC_API_KEY
ANTHROPIC_MODEL_DRAFTING=claude-sonnet-5
ANTHROPIC_MODEL_CLASSIFY=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_VISION=claude-sonnet-5
AI_MONTHLY_SPEND_CEILING_USD=400

# --- Embeddings --------------------------------------------------------------
# voyage-law-2 is legal-domain tuned (1024 dims). Dimension is FIXED at project
# start and recorded on every row in chunks.embedding_model_version.
EMBEDDING_PROVIDER=voyage                  # voyage | openai
EMBEDDING_API_KEY=secret://chambersofkoon-prod/prod/EMBEDDING_API_KEY
EMBEDDING_MODEL_VERSION=voyage-law-2
EMBEDDING_DIMENSIONS=1024

# --- Email (Resend) ----------------------------------------------------------
RESEND_API_KEY=secret://chambersofkoon-prod/prod/RESEND_API_KEY
# Must be on a domain VERIFIED in Resend. A subdomain of a verified
# domain is not automatically verified.
RESEND_FROM_ADDRESS=notifications@eiaawsolutions.com
RESEND_FROM_NAME=Messrs Chambers of Koon
RESEND_REPLY_TO=enquiry@chambersofkoon.com.my
RESEND_WEBHOOK_SECRET=secret://chambersofkoon-prod/prod/RESEND_WEBHOOK_SECRET

# --- Object storage (S3-compatible / Cloudflare R2) --------------------------
STORAGE_ENDPOINT=https://<account>.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_BUCKET=chambersofkoon-matters
STORAGE_ACCESS_KEY_ID=secret://chambersofkoon-prod/prod/STORAGE_ACCESS_KEY_ID
STORAGE_SECRET_ACCESS_KEY=secret://chambersofkoon-prod/prod/STORAGE_SECRET_ACCESS_KEY

# --- Auth (Auth.js v5 / OIDC) ------------------------------------------------
AUTH_SECRET=secret://chambersofkoon-prod/prod/AUTH_SECRET
AUTH_TRUST_HOST=true
AUTH_GOOGLE_ID=secret://chambersofkoon-prod/prod/AUTH_GOOGLE_ID
AUTH_GOOGLE_SECRET=secret://chambersofkoon-prod/prod/AUTH_GOOGLE_SECRET
AUTH_MICROSOFT_ID=secret://chambersofkoon-prod/prod/AUTH_MICROSOFT_ID
AUTH_MICROSOFT_SECRET=secret://chambersofkoon-prod/prod/AUTH_MICROSOFT_SECRET
AUTH_MICROSOFT_TENANT_ID=secret://chambersofkoon-prod/prod/AUTH_MICROSOFT_TENANT_ID
ALLOWED_EMAIL_DOMAINS=chambersofkoon.com.my
SESSION_MAX_AGE_SECONDS=43200              # 12 hours (FR-1.4)

# --- Application-layer field encryption (NFR-1.2) ----------------------------
# 32-byte key, base64. Encrypts clients.id_number_encrypted at rest.
FIELD_ENCRYPTION_KEY=secret://chambersofkoon-prod/prod/FIELD_ENCRYPTION_KEY

# --- Public intake widget ----------------------------------------------------
WIDGET_PUBLIC_KEY=cok_public_dev_key
WIDGET_ALLOWED_ORIGINS=https://chambersofkoon.com.my,https://www.chambersofkoon.com.my

# The terms and privacy policy an enquirer accepts before intake begins.
# Bump TERMS_VERSION whenever either document is revised — every acceptance is
# recorded against it, and an acceptance only proves something if it says what
# was accepted.
TERMS_URL=https://www.chambersofkoon.com.my/terms-conditions/
PRIVACY_URL=https://www.chambersofkoon.com.my/privacy-policy/
TERMS_VERSION=2026-08-12
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=secret://chambersofkoon-prod/prod/TURNSTILE_SECRET_KEY
TURNSTILE_ENABLED=false                    # true in uat + production

# --- Observability -----------------------------------------------------------
SENTRY_DSN=secret://chambersofkoon-prod/prod/SENTRY_DSN
NEXT_PUBLIC_SENTRY_DSN=
LOG_LEVEL=info

# --- Scheduling defaults (FR-3.5) --------------------------------------------
PROPOSAL_EXPIRY_WORKING_HOURS=12
